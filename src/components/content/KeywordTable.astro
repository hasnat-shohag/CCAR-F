---
import glossary from '../../content/glossary-terms.json';

// Definitions live in the glossary so a lesson cannot drift from it
// (CONTRIBUTING rule 6). `keywords` carries the terms in the lesson's curated
// exam order; we resolve each to its canonical entry and keep that order.
interface Keyword {
	term: string;
}

interface Props {
	keywords: Keyword[];
	caption?: string;
}

const { keywords, caption = 'দ্রুত রিভিশনের জন্য মূল শব্দগুলো' } = Astro.props;

const byTerm = new Map(glossary.map((entry) => [entry.term, entry]));

const rows = keywords.map((keyword) => {
	const entry = byTerm.get(keyword.term);
	if (!entry) {
		throw new Error(
			`KeywordTable: "${keyword.term}" is not in src/content/glossary-terms.json. ` +
				`Add the glossary entry first (CONTRIBUTING rule 6), or fix the term's spelling.`,
		);
	}
	return entry;
});
---

<div class="table-scroll">
	<table class="keyword-table">
		<caption>{caption}</caption>
		<thead>
			<tr>
				<th scope="col">শব্দ (English)</th>
				<th scope="col">বাংলা অর্থ</th>
				<th scope="col">পরীক্ষার টিপ</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((entry) => (
					<tr>
						<td class="keyword-term">{entry.term}</td>
						<td>{entry.bn}</td>
						<td>{entry.tip ?? '—'}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>
