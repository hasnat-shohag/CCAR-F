---
interface Step {
	title: string;
	why?: string;
	expect?: string;
}

interface Props {
	title: string;
	difficulty?: string;
	time?: string;
	objectives?: string[];
	steps: Step[];
}

const { title, difficulty, time, objectives, steps } = Astro.props;
---

<aside class="build-exercise">
	<span class="callout-label">বিল্ড এক্সারসাইজ</span>
	<p><strong>{title}</strong></p>
	<div class="build-meta">
		{difficulty && <span>লেভেল: {difficulty}</span>}
		{time && <span>সময়: {time}</span>}
	</div>
	{
		objectives && objectives.length > 0 && (
			<>
				<p>যা শিখবেন:</p>
				<ul>
					{objectives.map((objective) => (
						<li>{objective}</li>
					))}
				</ul>
			</>
		)
	}
	<ol>
		{
			steps.map((step) => (
				<li>
					<span>{step.title}</span>
					{step.why && <span class="build-why">কেন: {step.why}</span>}
					{step.expect && <span class="build-expect">যা দেখবেন: {step.expect}</span>}
				</li>
			))
		}
	</ol>
</aside>
