---
/**
 * Dense reference table for the quick-reference sheets and the exam guide.
 *
 * The first column is rendered as a row header, so each row reads as
 * "<subject> → <what it means>". Wrap any span in backticks to render it as
 * inline code, which keeps English identifiers (`stop_reason`, `--bare`)
 * visually distinct inside Bangla prose.
 */
interface Props {
	columns: string[];
	rows: string[][];
	caption?: string;
	/** Zero-based column indexes rendered in the monospace term style. */
	monoColumns?: number[];
}

const { columns, rows, caption, monoColumns = [] } = Astro.props;

const isCode = (partIndex: number) => partIndex % 2 === 1;
const isMono = (index: number) => monoColumns.includes(index);
---

<div class="table-scroll">
	<table class="keyword-table ref-table">
		{caption && <caption>{caption}</caption>}
		<thead>
			<tr>
				{
					columns.map((column) => (
						<th scope="col">
							{column.split('`').map((part, index) => (isCode(index) ? <code>{part}</code> : part))}
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr>
						{row.map((cell, index) =>
							index === 0 ? (
								<th scope="row" class={isMono(index) ? 'keyword-term' : undefined}>
									{cell.split('`').map((part, partIndex) =>
										isCode(partIndex) ? <code>{part}</code> : part,
									)}
								</th>
							) : (
								<td class={isMono(index) ? 'keyword-term' : undefined}>
									{cell.split('`').map((part, partIndex) =>
										isCode(partIndex) ? <code>{part}</code> : part,
									)}
								</td>
							),
						)}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
